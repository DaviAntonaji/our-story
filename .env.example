# Copie para `.env` na raiz (não commitar).
# Use URL completa com https://. No GitHub Actions o secret RECADOS_API_URL pode omitir o https://.

VITE_RECADOS_API_URL=
VITE_TURNSTILE_SITE_KEY=

# ID de medição (opcional, ex.: G-XXXXXXXX). Só aparece o aviso de cookies se estiver definido. No CI: secret VITE_GA_MEASUREMENT_ID.
VITE_GA_MEASUREMENT_ID=

# Chave do CARTO Basemaps usada nos tiles do mapa (opcional — sem ela o mapa usa o
# endpoint público do CARTO). Atenção: num site estático essa chave vai no bundle e
# fica visível; restrinja o domínio no painel do CARTO. No CI: secret CARTO_BASEMAPS_API_KEY.
VITE_CARTO_API_KEY=

# URL pública do site (https://…), usada no build para gerar sitemap.xml com <image:image>.
# Alternativa: VITE_SITE_URL=… (lido pelo mesmo script) ou SITE_ORIGIN em src/data/constants.js.
# No GitHub Actions: secret SITE_URL (mesmo valor da URL canônica no Search Console).
SITE_URL=
